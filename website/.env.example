# Spotify API — get from https://developer.spotify.com/dashboard
# SPOTIFY_REFRESH_TOKEN: obtain by running `node spotify-setup.js <CLIENT_ID> <CLIENT_SECRET>`
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam API — get key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
STEAM_ID=

# Riot Games API — get key from https://developer.riotgames.com
RIOT_API_KEY=
RIOT_NAME=
RIOT_TAG=
